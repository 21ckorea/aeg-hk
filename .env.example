# Neon Marketplace integration adds this automatically in Vercel.
# Never expose this value to browser code or commit it to Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Google Cloud OAuth 2.0 web client ID (safe to expose to the browser).
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Server-only session signing key: 32+ characters, never commit it.
APP_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Comma-separated Google accounts approved to use the intranet.
INTRANET_ALLOWED_EMAILS=admin@gmail.com,staff@example.com
